# =============================================================================
# LinkMind — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# Server
PORT=8080
BASE_URL=http://localhost:8080     # Base URL used to build short URLs

# Database
DATABASE_URL=postgres://linkmind_user:linkmind_password@localhost:5432/linkmind_db?sslmode=disable

# Security
API_KEY=change_me_to_a_secure_random_key

# AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash      # Free tier with generous quota

# Rate Limiting
RATE_LIMIT_RPM=60                  # Requests per minute per IP

# Enrichment Worker
ENRICHMENT_WORKERS=3               # Parallel goroutines for URL processing
SCRAPER_TIMEOUT_SECS=10            # HTTP timeout for scraping URLs
